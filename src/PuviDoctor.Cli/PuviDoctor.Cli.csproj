<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    
    <!-- Version & Metadata -->
    <Version>2.0.0-alpha.1</Version>
    <Authors>Puviraj</Authors>
    <Company>Puviraj</Company>
    <Description>Fast, project-aware developer machine diagnostics, PATH sanitizer, and environment repair CLI.</Description>
    <PackageProjectUrl>https://github.com/Puviraj-2004/hostfix</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Puviraj-2004/hostfix</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <!-- Global .NET Tool Packaging: CLI command name is 'hostfix' -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>hostfix</ToolCommandName>
    <PackageId>hostfix</PackageId>
    <PackageOutputPath>../../artifacts</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PuviDoctor.Core\PuviDoctor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.49.1" />
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
  </ItemGroup>

</Project>
